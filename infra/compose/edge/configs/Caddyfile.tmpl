    reverse_proxy {$OPERATOR_UPSTREAM:app:3000} {
      header_up X-Real-IP {remote_host}
      transport http {
        response_header_timeout 10s
      }
    }
  }

  reverse_proxy {$OPERATOR_UPSTREAM:app:3000}

  log {
    format json
    output stdout
  }
}

